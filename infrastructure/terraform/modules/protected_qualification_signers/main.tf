# Non-deploying Terraform identities for TWO independently controlled signers.
# No private key content is stored or generated by Terraform; secrets and
# parent agent roles MUST already be provisioned through separate governance.
locals {
  partition     = startswith(var.aws_region, "us-gov-") ? "aws-us-gov" : "aws"
  role_prefix   = "arn:${local.partition}:iam::${var.aws_account_id}:role/"
  policy_prefix = "arn:${local.partition}:iam::${var.aws_account_id}:policy/"
  secret_prefix = "arn:${local.partition}:secretsmanager:${var.aws_region}:${var.aws_account_id}:secret:"
  key_prefix    = "arn:${local.partition}:kms:${var.aws_region}:${var.aws_account_id}:key/"
  tag_base      = merge(var.tags, {
    Component   = "northstar-independent-qualification-signers"
    Environment = var.environment
    ManagedBy   = "terraform"
  })

  # Exact IAM/SecretsManager/KMS ARN, account, region and independence checks.
  # Prefix checks alone would permit child resources in another account.
  inputs_are_isolated = (
    data.aws_caller_identity.current.account_id == var.aws_account_id &&
    data.aws_region.current.name == var.aws_region &&
    startswith(var.publisher_agent_role_arn, local.role_prefix) &&
    startswith(var.test_signer_agent_role_arn, local.role_prefix) &&
    startswith(var.release_signer_agent_role_arn, local.role_prefix) &&
    startswith(var.signer_permissions_boundary_arn, local.policy_prefix) &&
    startswith(var.test_signing_secret_arn, local.secret_prefix) &&
    startswith(var.release_signing_secret_arn, local.secret_prefix) &&
    startswith(var.test_signing_kms_key_arn, local.key_prefix) &&
    startswith(var.release_signing_kms_key_arn, local.key_prefix) &&
    length(distinct([
      var.publisher_agent_role_arn,
      var.test_signer_agent_role_arn,
      var.release_signer_agent_role_arn
    ])) == 3 &&
    var.test_signing_secret_arn != var.release_signing_secret_arn &&
    var.test_signing_kms_key_arn != var.release_signing_kms_key_arn
  )
}

data "aws_caller_identity" "current" {}
data "aws_region" "current" {}

data "aws_iam_policy_document" "test_signer_trust" {
  statement {
    sid     = "OnlyIndependentTestSignerAgent"
    effect  = "Allow"
    actions = ["sts:AssumeRole"]
    principals {
      type        = "AWS"
      identifiers = [var.test_signer_agent_role_arn]
    }
    condition {
      test     = "ArnEquals"
      variable = "aws:PrincipalArn"
      values   = [var.test_signer_agent_role_arn]
    }
    condition {
      test     = "StringLike"
      variable = "sts:RoleSessionName"
      values   = ["northstar-test-jenkins-*"]
    }
  }
}

data "aws_iam_policy_document" "release_signer_trust" {
  statement {
    sid     = "OnlyIndependentReleaseAuthorityAgent"
    effect  = "Allow"
    actions = ["sts:AssumeRole"]
    principals {
      type        = "AWS"
      identifiers = [var.release_signer_agent_role_arn]
    }
    condition {
      test     = "ArnEquals"
      variable = "aws:PrincipalArn"
      values   = [var.release_signer_agent_role_arn]
    }
    condition {
      test     = "StringLike"
      variable = "sts:RoleSessionName"
      values   = ["northstar-release-jenkins-*"]
    }
  }
}

resource "aws_iam_role" "test_signer" {
  name                 = "${var.name_prefix}-test-certification-signer"
  assume_role_policy   = data.aws_iam_policy_document.test_signer_trust.json
  permissions_boundary = var.signer_permissions_boundary_arn
  max_session_duration = 3600
  tags                 = merge(local.tag_base, { Signer = "test-attestation" })

  lifecycle {
    precondition {
      condition     = local.inputs_are_isolated
      error_message = "Signers, publisher, KMS keys and pre-existing secrets must belong to the approved account/region and use independent identities."
    }
  }
}

resource "aws_iam_role" "release_signer" {
  name                 = "${var.name_prefix}-release-manifest-signer"
  assume_role_policy   = data.aws_iam_policy_document.release_signer_trust.json
  permissions_boundary = var.signer_permissions_boundary_arn
  max_session_duration = 3600
  tags                 = merge(local.tag_base, { Signer = "release-manifest" })

  lifecycle {
    precondition {
      condition     = local.inputs_are_isolated
      error_message = "Release authority signer must be isolated from test signer and publishing agent."
    }
  }
}

data "aws_iam_policy_document" "test_signing_secret" {
  statement {
    sid       = "ReadOnlyOwnAttestationSecret"
    effect    = "Allow"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [var.test_signing_secret_arn]
  }

  statement {
    sid       = "DecryptOwnAttestationSecretViaSecretsManager"
    effect    = "Allow"
    actions   = ["kms:Decrypt"]
    resources = [var.test_signing_kms_key_arn]
    condition {
      test     = "StringEquals"
      variable = "kms:ViaService"
      values   = ["secretsmanager.${var.aws_region}.amazonaws.com"]
    }
    condition {
      test     = "StringEquals"
      variable = "kms:EncryptionContext:SecretARN"
      values   = [var.test_signing_secret_arn]
    }
  }
}

data "aws_iam_policy_document" "release_signing_secret" {
  statement {
    sid       = "ReadOnlyOwnReleaseSigningSecret"
    effect    = "Allow"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [var.release_signing_secret_arn]
  }

  statement {
    sid       = "DecryptOwnReleaseSecretViaSecretsManager"
    effect    = "Allow"
    actions   = ["kms:Decrypt"]
    resources = [var.release_signing_kms_key_arn]
    condition {
      test     = "StringEquals"
      variable = "kms:ViaService"
      values   = ["secretsmanager.${var.aws_region}.amazonaws.com"]
    }
    condition {
      test     = "StringEquals"
      variable = "kms:EncryptionContext:SecretARN"
      values   = [var.release_signing_secret_arn]
    }
  }
}

resource "aws_iam_role_policy" "test_signer" {
  name   = "${var.name_prefix}-read-test-signing-secret-only"
  role   = aws_iam_role.test_signer.id
  policy = data.aws_iam_policy_document.test_signing_secret.json
}

resource "aws_iam_role_policy" "release_signer" {
  name   = "${var.name_prefix}-read-release-signing-secret-only"
  role   = aws_iam_role.release_signer.id
  policy = data.aws_iam_policy_document.release_signing_secret.json
}

# Deliberately no s3:PutObject, AWS deployment, IAM mutation, or signer private
# key values. Publisher role cannot assume or read from either signing role.
