NEXT_PUBLIC_SITE_NAME="Your organization"
NEXT_PUBLIC_SITE_TAGLINE="An accessible place to learn about our services"
NEXT_PUBLIC_SITE_DESCRIPTION="Discover what we offer and how to contact us."
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set to true ONLY after brand, claims, privacy, site URL, public routes and SEO review.
NEXT_PUBLIC_SITE_APPROVED="false"

# Server-side public-only CMS endpoint; do not set to admin API and never pass auth tokens.
WEBSITE_CMS_PUBLIC_API_URL=""

# Server-only values; use a SELECT-only role with access only to public_published_pages view.
WEBSITE_CMS_DATABASE_URL=""
WEBSITE_CMS_SITE_SLUG=""

# Do not enable until PostgreSQL migrations, application role, anti-abuse controls and privacy approval are verified.
WEBSITE_LEAD_CAPTURE_ENABLED="false"
WEBSITE_LEADS_DATABASE_URL=""
WEBSITE_CANONICAL_ORIGIN="http://localhost:3000"

# Authenticated CMS API stays OFF until externally issued RS256 tokens,
# PostgreSQL tenant row-level security, and operational review are verified.
WEBSITE_CMS_OWNER_API_ENABLED="false"
WEBSITE_CMS_OWNER_DB_RLS_VERIFIED="false"
WEBSITE_CMS_EDITOR_DATABASE_URL=""
WEBSITE_CMS_OWNER_SITE_ID=""
WEBSITE_CMS_OIDC_ISSUER=""
WEBSITE_CMS_OIDC_AUDIENCE=""
WEBSITE_CMS_OIDC_JWKS_URL=""

# Mandatory content-preservation invariant: never auto-delete source posts/revisions/trash.
BLOG_AUTO_DELETE_ENABLED="false"

# Optional hosted owner sign-in: OIDC authorization-code + PKCE.
# Activate only after an approved HTTPS issuer, audience, client, and DB/RLS tests.
WEBSITE_CMS_OIDC_CLIENT_ID=""
WEBSITE_CMS_OIDC_AUTHORIZATION_ENDPOINT=""
WEBSITE_CMS_OIDC_TOKEN_ENDPOINT=""
# Server-only 32 random bytes, base64url encoded; never NEXT_PUBLIC.
WEBSITE_CMS_SESSION_KEY=""

# Lead CRM handoff is completely disabled until controller-approved purpose,
# receiver idempotency, least-privilege DB role and data processing terms are verified.
WEBSITE_CRM_DELIVERY_ENABLED="false"
WEBSITE_CRM_PRIVACY_APPROVED="false"
WEBSITE_CRM_WEBHOOK_URL=""
# Long, high-entropy secret shared with the receiving service. SERVER ONLY.
WEBSITE_CRM_WEBHOOK_SECRET=""

# Separate database role: SELECT site/lead data and narrowly scoped outbox UPDATE.
# Do not reuse WEBSITE_LEADS_DATABASE_URL public submission credentials.
WEBSITE_LEAD_WORKER_DATABASE_URL=""

# Durable PostgreSQL hourly admission backstop, required before enabling leads.
# Limit applies to NEW accepted submissions: 3/contact and 100/site per hour.
# Use a secret of at least 32 high-entropy characters; never expose to browser.
WEBSITE_LEAD_RATE_ENABLED="false"
WEBSITE_LEAD_RATE_SECRET=""

# Opt-in readiness probe for only the read-only public CMS database/view.
# OFF by default: liveness does not imply full production release approval.
WEBSITE_RUNTIME_READINESS_ENABLED="false"

# OPTIONAL CMS publication reconciliation; off until signing, routing, CDN and
# worker least-privilege DB role are approved and integration-tested.
WEBSITE_CMS_REVALIDATION_ENABLED="false"
WEBSITE_CMS_OUTBOX_WORKER_DATABASE_URL=""
# Same server-only >=32 character high-entropy secret on worker and Next app.
WEBSITE_CMS_REVALIDATION_SECRET=""

# Media intake is quarantined METADATA ONLY. No image upload/scanner/public serving.
# Keep OFF until migration 011, owner RBAC, audit and tenant isolation are validated.
WEBSITE_MEDIA_MANIFEST_ENABLED="false"

# PRIVATE, opt-in quarantine byte uploads (requires prior manifest and owner auth).
# Compatible with self-hosted S3/MinIO. Do not use public buckets or write ACLs.
# Upload does NOT imply media scan, copyright approval or public publishing.
WEBSITE_MEDIA_UPLOAD_ENABLED="false"
WEBSITE_MEDIA_STORAGE_ENDPOINT=""
WEBSITE_MEDIA_STORAGE_BUCKET=""
WEBSITE_MEDIA_STORAGE_REGION="us-east-1"
WEBSITE_MEDIA_STORAGE_ACCESS_KEY_ID=""
WEBSITE_MEDIA_STORAGE_SECRET_ACCESS_KEY=""
# Only for nonproduction local MinIO at http://localhost or 127.0.0.1.
WEBSITE_MEDIA_STORAGE_LOCAL_DEV="false"

# Internal private media inspection, OFF until independently operated ClamAV and
# role-scoped Postgres/storage are verified. Never share these secrets in browser.
WEBSITE_MEDIA_SCAN_ENABLED="false"
WEBSITE_MEDIA_SCANNER_DB_ROLE_VERIFIED="false"
WEBSITE_MEDIA_SCANNER_DATABASE_URL=""
WEBSITE_MEDIA_SCAN_DISPATCH_DATABASE_URL=""
WEBSITE_MEDIA_SCANNER_ACTOR_ID=""
WEBSITE_MEDIA_SCAN_WORKER_SECRET=""
# ClamAV clamd INSTREAM daemon on same host / network namespace, loopback only.
WEBSITE_MEDIA_CLAMD_PORT="3310"

# Independent media reviewer (distinct from uploader), OFF by default.
# Separate DB role may list inspected evidence and record reviewer decisions only.
WEBSITE_MEDIA_REVIEW_ENABLED="false"
WEBSITE_MEDIA_REVIEW_DB_ROLE_VERIFIED="false"
WEBSITE_MEDIA_REVIEW_DATABASE_URL=""

# SEPARATE media publication from independent scan/review. OFF by default.
# Writer: narrowly scoped approved-asset publication and audit INSERT only.
WEBSITE_MEDIA_PUBLICATION_ENABLED="false"
WEBSITE_MEDIA_PUBLISH_DB_ROLE_VERIFIED="false"
WEBSITE_MEDIA_PUBLICATION_DATABASE_URL=""
# Public media delivery reads ONLY public_published_media view through a
# dedicated reader and uses separate READ-ONLY private object-store credentials.
WEBSITE_MEDIA_PUBLIC_DELIVERY_ENABLED="false"
WEBSITE_MEDIA_PUBLIC_READER_GRANTS_VERIFIED="false"
WEBSITE_MEDIA_PUBLIC_DATABASE_URL=""
WEBSITE_MEDIA_PUBLIC_STORAGE_ENDPOINT=""
WEBSITE_MEDIA_PUBLIC_STORAGE_BUCKET=""
WEBSITE_MEDIA_PUBLIC_STORAGE_REGION="us-east-1"
WEBSITE_MEDIA_PUBLIC_STORAGE_ACCESS_KEY_ID=""
WEBSITE_MEDIA_PUBLIC_STORAGE_SECRET_ACCESS_KEY=""


# Versioned optional consent and first-party analytics: disabled by default.
# Apply migration 014 and verify privacy processing/retention/DSAR policy.
WEBSITE_CONSENT_RECORDS_ENABLED="false"
WEBSITE_PRIVACY_DB_GRANTS_VERIFIED="false"
WEBSITE_PRIVACY_DATABASE_URL=""
WEBSITE_ANALYTICS_COLLECTION_ENABLED="false"
WEBSITE_ANALYTICS_REPORTING_ENABLED="false"
WEBSITE_ANALYTICS_READ_GRANTS_VERIFIED="false"
WEBSITE_ANALYTICS_REPORT_DATABASE_URL=""

# Internal marketing automation drafts/simulation only. CRM and live effects deferred.
# Apply migration 015 and verify tenant isolation + cms:automation OIDC permission.
WEBSITE_AUTOMATION_DRAFTS_ENABLED="false"
WEBSITE_AUTOMATION_DB_ROLE_VERIFIED="false"
WEBSITE_AUTOMATION_DATABASE_URL=""

# Explicit read-only grant check. Use separately provisioned TEST/STAGING
# roles equivalent to production. No migrations or writes will be performed.
WEBSITE_SECURITY_VERIFY_ALLOW="false"
WEBSITE_SECURITY_VERIFY_DATABASE_URL=""
WEBSITE_SECURITY_VERIFY_ROLE="public-cms-reader"


# Optional CMS session-only recovery. Never use on shared devices without approval;
# disabled until an operator signs off on unpublished-content local storage risk.
NEXT_PUBLIC_EDITOR_RECOVERY_ENABLED="false"

# Internal synthetic automation run state and one-shot tick. No real CRM,
# customer messages, subscription enrollment, scheduled live send, or ad sync.
# Install migration 016 first; use a narrowly scoped site-aware database role.
WEBSITE_AUTOMATION_INTERNAL_RUNS_ENABLED="false"
WEBSITE_AUTOMATION_RUN_DB_ROLE_VERIFIED="false"
WEBSITE_AUTOMATION_RUN_DATABASE_URL=""
WEBSITE_AUTOMATION_RUNNER_ENABLED="false"
WEBSITE_AUTOMATION_RUNNER_ACTOR_ID=""
WEBSITE_AUTOMATION_RUNNER_SECRET=""
# HTTP loopback origin is only permitted for explicitly opted-in development.
WEBSITE_AUTOMATION_LOCAL_DEV="false"


# Chapter 59: private privacy-rights case ledger (OFF until legal/workflow
# approval, tenant RLS, reviewer IdP claims and staging DB grant proof).
# Does NOT erase data, email processors, or collect requester identity.
WEBSITE_PRIVACY_RIGHTS_ENABLED="false"
WEBSITE_PRIVACY_RIGHTS_DB_GRANTS_VERIFIED="false"
WEBSITE_PRIVACY_RIGHTS_DATABASE_URL=""


# Approved same-site SEO content redirect registry (migration 019).
# Writer role requires cms:redirect and verified PostgreSQL tenant isolation.
# Public role must SELECT only the dedicated security-barrier view.
WEBSITE_REDIRECT_EDITOR_ENABLED="false"
WEBSITE_REDIRECT_EDITOR_GRANTS_VERIFIED="false"
WEBSITE_REDIRECT_EDITOR_DATABASE_URL=""
WEBSITE_REDIRECT_PUBLIC_ENABLED="false"
WEBSITE_REDIRECT_PUBLIC_GRANTS_VERIFIED="false"
WEBSITE_REDIRECT_PUBLIC_DATABASE_URL=""


# Optional OIDC owner MFA enforcement. Set true only after the real IdP emits
# cryptographically signed amr/auth_time claims or an approved exact acr value.
# Never accept unsigned client-provided MFA flags or bypass on token failure.
WEBSITE_CMS_REQUIRE_MFA="false"
WEBSITE_CMS_MFA_ACCEPTED_ACR=""
